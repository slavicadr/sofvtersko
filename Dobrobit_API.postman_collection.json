      "item": [
        {
          "name": "Registracija kupca",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/korisnici/registracija/kupac",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ime\": \"Ana\",\n  \"prezime\": \"Anić\",\n  \"email\": \"ana@test.com\",\n  \"lozinkaHash\": \"Lozinka123\",\n  \"tipKorisnika\": \"kupac\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.test('Has korisnikId', () => pm.expect(json).to.have.property('korisnikId'));",
            "pm.test('No password in response', () => { pm.expect(json).to.not.have.property('lozinkaHash'); pm.expect(json).to.not.have.property('password'); });",
            "pm.collectionVariables.set('kupacId', json.korisnikId);"
          ]}}]
        },
        {
          "name": "Registracija volontera",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/korisnici/registracija",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
