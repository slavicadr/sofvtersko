      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));"
      ]}}]
    },
    {
      "name": "14. Create Verifikacija (admin only — expect 401 as kupac)",
      "request": { "method": "POST", "url": "http://localhost:8080/api/verifikacije",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [{ "key": "username", "value": "kupac_t1@test.com" }, { "key": "password", "value": "TestPass123" }] },
        "body": { "mode": "raw", "raw": "{\"tipVerifikacije\":\"volonter\",\"napomena\":\"Test\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('403 for non-admin', () => pm.response.to.have.status(403));"
      ]}}]
    },
    {
      "name": "15. Buy Usluga as Kupac (uses existing active usluga ID=7)",
      "request": { "method": "POST", "url": "http://localhost:8080/api/kupovine/kupi",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [{ "key": "username", "value": "kupac_t1@test.com" }, { "key": "password", "value": "TestPass123" }] },
        "body": { "mode": "raw", "raw": "{\"kupacId\":{{kupacId}},\"uslugaId\":1,\"pomocId\":1,\"nacinPlacanja\":\"KARTICA\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('kupovinaId', pm.response.json().kupovinaId);"
      ]}}]
    },
    {
      "name": "16. Add Recenzija as Kupac",
      "request": { "method": "POST", "url": "http://localhost:8080/api/recenzije/dodaj",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [{ "key": "username", "value": "kupac_t1@test.com" }, { "key": "password", "value": "TestPass123" }] },
        "body": { "mode": "raw", "raw": "{\"kupovinaId\":{{kupovinaId}},\"kupacId\":{{kupacId}},\"brojZvjezdica\":5,\"komentar\":\"Odlicna usluga!\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));"
      ]}}]
    },
