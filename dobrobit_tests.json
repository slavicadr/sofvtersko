      "request": { "method": "POST", "url": "http://localhost:8080/api/usluge-proizvodi/filter-kategorija",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [{ "key": "username", "value": "kupac_t1@test.com" }, { "key": "password", "value": "TestPass123" }] },
        "body": { "mode": "raw", "raw": "{\"kategorijaId\":1}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ]}}]
    },
    {
      "name": "18. Filter Usluge by Volonter",
      "request": { "method": "POST", "url": "http://localhost:8080/api/usluge-proizvodi/filter-volonter",
